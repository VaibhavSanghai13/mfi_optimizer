// Single source of truth for the data model (see docs/architecture.md §5).
//
// Conventions
// - Database names are snake_case (@map / @@map); Prisma names are camelCase.
// - IDs are UUIDs generated by PostgreSQL.
// - Times of day are "HH:MM" text, matching the UI contract in lib/types.ts.
//
// Migrations are generated with `prisma migrate diff` and run in the Supabase SQL editor.
// Check constraints and Row Level Security cannot be expressed here; they are
// hand-written at the end of each migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app at runtime
  directUrl = env("DIRECT_URL") // direct connection, used by the Prisma CLI
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  manager
  field_officer

  @@map("user_role")
}

enum Weekday {
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat

  @@map("weekday")
}

enum MeetingFrequency {
  weekly
  fortnightly
  monthly

  @@map("meeting_frequency")
}

enum Priority {
  high
  medium
  low

  @@map("priority")
}

enum PriorityReason {
  overdue
  disbursement
  new_group
  routine

  @@map("priority_reason")
}

enum GroupSource {
  synthetic
  manual

  @@map("group_source")
}

enum PlanStatus {
  optimal
  feasible
  partial
  infeasible

  @@map("plan_status")
}

enum UnassignedReason {
  time_window_conflict
  exceeds_working_hours
  low_priority_dropped
  unreachable

  @@map("unassigned_reason")
}

// ───────────────────────── Organisation ─────────────────────────

model Branch {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  district String
  taluka   String
  address  String
  lat      Float
  lng      Float

  settings Settings?
  officers Officer[]
  users    User[]
  groups   JlgGroup[]
  plans    Plan[]

  @@map("branches")
}

model Officer {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String  @map("branch_id") @db.Uuid
  name              String
  /// Where the officer's day starts and ends; defaults to the branch location.
  startLat          Float   @map("start_lat")
  startLng          Float   @map("start_lng")
  shiftStart        String  @map("shift_start")
  shiftEnd          String  @map("shift_end")
  breakStart        String  @map("break_start")
  breakDurationMin  Int     @map("break_duration_min")
  maxMeetingsPerDay Int     @map("max_meetings_per_day")
  vehicle           String  @default("two_wheeler")
  color             String
  active            Boolean @default(true)

  branch         Branch      @relation(fields: [branchId], references: [id])
  user           User?
  assignedGroups JlgGroup[]
  planRoutes     PlanRoute[]

  @@map("officers")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  branchId     String   @map("branch_id") @db.Uuid
  /// Required for field officers (check constraint); one officer ↔ at most one user.
  officerId    String?  @unique @map("officer_id") @db.Uuid
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch        Branch     @relation(fields: [branchId], references: [id])
  officer       Officer?   @relation(fields: [officerId], references: [id], onDelete: Restrict)
  createdGroups JlgGroup[]
  createdPlans  Plan[]

  @@map("users")
}

model Settings {
  branchId                  String  @id @map("branch_id") @db.Uuid
  // Working defaults — pre-fill new officers and groups
  defaultShiftStart         String  @default("08:30") @map("default_shift_start")
  defaultShiftEnd           String  @default("17:30") @map("default_shift_end")
  defaultBreakStart         String  @default("13:00") @map("default_break_start")
  defaultBreakDurationMin   Int     @default(30) @map("default_break_duration_min")
  defaultMeetingDurationMin Int     @default(30) @map("default_meeting_duration_min")
  // Travel
  osrmUrl                   String  @default("https://router.project-osrm.org") @map("osrm_url")
  /// Multiplies OSRM car travel times to approximate a two-wheeler.
  speedFactor               Float   @default(1.0) @map("speed_factor")
  bufferMin                 Int     @default(5) @map("buffer_min")
  // Optimization
  penaltyHigh               Int     @default(1000) @map("penalty_high")
  penaltyMedium             Int     @default(300) @map("penalty_medium")
  penaltyLow                Int     @default(50) @map("penalty_low")
  allowLateArrival          Boolean @default(false) @map("allow_late_arrival")
  solverTimeLimitSec        Int     @default(10) @map("solver_time_limit_sec")
  balanceWorkload           Boolean @default(true) @map("balance_workload")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ─────────────────────────── JLG groups ───────────────────────────

model JlgGroup {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId           String           @map("branch_id") @db.Uuid
  name               String
  centerCode         String           @map("center_code")
  village            String
  taluka             String
  district           String
  lat                Float
  lng                Float
  memberCount        Int              @map("member_count")
  meetingDay         Weekday          @map("meeting_day")
  meetingFrequency   MeetingFrequency @default(weekly) @map("meeting_frequency")
  windowStart        String           @map("window_start")
  windowEnd          String           @map("window_end")
  meetingDurationMin Int              @map("meeting_duration_min")
  priority           Priority
  priorityReason     PriorityReason   @map("priority_reason")
  /// Null = any officer may visit this group.
  assignedOfficerId  String?          @map("assigned_officer_id") @db.Uuid
  active             Boolean          @default(true)
  source             GroupSource
  createdBy          String           @map("created_by") @db.Uuid
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch          Branch           @relation(fields: [branchId], references: [id])
  assignedOfficer Officer?         @relation(fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  creator         User             @relation(fields: [createdBy], references: [id])
  planStops       PlanStop[]
  planUnassigned  PlanUnassigned[]

  // The Planner loads "active groups of this branch meeting on this weekday".
  @@index([branchId, meetingDay, active])
  @@map("jlg_groups")
}

// ───────────────────────────── Plans ─────────────────────────────

model Plan {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId            String     @map("branch_id") @db.Uuid
  date                DateTime   @db.Date
  status              PlanStatus
  solveTimeSec        Float      @map("solve_time_sec")
  /// Drafts (false) are not listed in plan history.
  saved               Boolean    @default(false)
  // KPIs
  meetingsPlanned     Int        @map("meetings_planned")
  meetingsTotal       Int        @map("meetings_total")
  highPriorityCovered Int        @map("high_priority_covered")
  highPriorityTotal   Int        @map("high_priority_total")
  totalDistanceKm     Float      @map("total_distance_km")
  totalTravelMin      Int        @map("total_travel_min")
  avgUtilizationPct   Float      @map("avg_utilization_pct")
  createdBy           String     @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  branch     Branch           @relation(fields: [branchId], references: [id])
  creator    User             @relation(fields: [createdBy], references: [id])
  routes     PlanRoute[]
  unassigned PlanUnassigned[]

  @@index([branchId, date])
  @@map("plans")
}

model PlanRoute {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId           String  @map("plan_id") @db.Uuid
  officerId        String  @map("officer_id") @db.Uuid
  startTime        String  @map("start_time")
  endTime          String  @map("end_time")
  totalTravelMin   Int     @map("total_travel_min")
  totalDistanceKm  Float   @map("total_distance_km")
  totalWaitMin     Int     @map("total_wait_min")
  totalMeetingMin  Int     @map("total_meeting_min")
  /// Travel from the last stop back to the start location.
  returnTravelMin  Int     @map("return_travel_min")
  returnDistanceKm Float   @map("return_distance_km")
  breakStart       String? @map("break_start")
  breakEnd         String? @map("break_end")
  /// Road-shaped polyline from OSRM as [lng, lat][].
  geometry         Json

  plan    Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  officer Officer    @relation(fields: [officerId], references: [id])
  stops   PlanStop[]

  @@unique([planId, officerId])
  @@map("plan_routes")
}

model PlanStop {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId            String @map("route_id") @db.Uuid
  sequence           Int
  groupId            String @map("group_id") @db.Uuid
  arrivalTime        String @map("arrival_time")
  waitMin            Int    @map("wait_min")
  meetingStart       String @map("meeting_start")
  meetingEnd         String @map("meeting_end")
  departureTime      String @map("departure_time")
  travelMinFromPrev  Int    @map("travel_min_from_prev")
  distanceKmFromPrev Float  @map("distance_km_from_prev")

  route PlanRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  group JlgGroup  @relation(fields: [groupId], references: [id])

  // Also serves as the (route_id, sequence) index for reading stops in order.
  @@unique([routeId, sequence])
  @@map("plan_stops")
}

model PlanUnassigned {
  planId  String           @map("plan_id") @db.Uuid
  groupId String           @map("group_id") @db.Uuid
  reason  UnassignedReason

  plan  Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  group JlgGroup @relation(fields: [groupId], references: [id])

  @@id([planId, groupId])
  @@map("plan_unassigned")
}

// ─────────────────────────── Travel cache ───────────────────────────

/// OSRM results per ordered pair of points. Car values, unscaled — the
/// two-wheeler speed factor is applied at solve time.
model TravelCache {
  /// "lat,lng" rounded to 5 decimals
  origin      String
  destination String
  durationSec Float    @map("duration_sec")
  distanceM   Float    @map("distance_m")
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([origin, destination])
  @@map("travel_cache")
}
