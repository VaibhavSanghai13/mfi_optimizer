# Copy this file to .env and fill in the values. Never commit .env.

# Supabase pooled connection (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase direct connection (port 5432) — used by the Prisma CLI (migrate diff / deploy).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Long random string shared by Next.js and the Python optimizer to sign/verify session JWTs.
JWT_SECRET="replace-with-a-long-random-string"

# Where Next.js calls the optimizer. Locally: the uvicorn server started by `npm run dev`.
OPTIMIZER_URL="http://127.0.0.1:8000/api/optimize"

# Initial value for settings.osrm_url when the seed data is generated.
OSRM_URL_DEFAULT="https://router.project-osrm.org"

# Only for `npm run seed:sql`: initial password of the seeded accounts (12+ characters).
# Never commit it; share it privately and reset passwords from the Users page after first sign-in.
SEED_PASSWORD="choose-a-long-random-password"

# Production only (Vercel): full URL of the Python optimizer in the same deployment.
# Locally leave it as above (http://127.0.0.1:8000/api/optimize).
# OPTIMIZER_URL="https://<your-project>.vercel.app/api/optimize"
