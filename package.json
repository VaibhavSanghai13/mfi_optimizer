{
  "name": "mfi-route-optimizer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.3.0",
  "scripts": {
    "dev": "concurrently -n next,py -c blue,yellow \"npm run dev:next\" \"npm run dev:py\"",
    "dev:next": "next dev",
    "dev:py": "python -m uvicorn api.optimize:app --port 8000 --reload --env-file .env",
    "dev:token": "tsx --env-file-if-exists=.env scripts/dev-token.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:py": "python -m pytest",
    "seed:sql": "tsx --env-file-if-exists=.env scripts/generate-seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@prisma/client": "6.19.3",
    "@vercel/analytics": "1.6.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.12",
    "leaflet": "1.9.4",
    "lucide-react": "1.17.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "5.0.0",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.4.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
